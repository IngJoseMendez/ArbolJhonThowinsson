# PostgreSQL. En Vercel la añade automáticamente la integración de Neon (Storage -> Neon).
DATABASE_URL=postgres://arbol:arbolpw@localhost:5432/arbol
# TLS: automático si el host no es local. Fuerce con true/false si hace falta.
# DATABASE_SSL=true

# Administrador general inicial (se crea sólo si no hay usuarios)
ADMIN_USER=admin
ADMIN_PASSWORD=cambie-esta-clave

# Normalización de teléfonos (+57 300 123 4567 == 3001234567)
PHONE_COUNTRY_CODE=57
PHONE_NATIONAL_LENGTH=10

# Fotos de las personas de confianza (Cloudinary). Se copia de Cloudinary → API Keys («API environment variable»).
# Sin esta variable las fotos quedan apagadas.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
