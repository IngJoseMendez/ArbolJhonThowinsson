{
  "name": "arbol-estructuras",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de gestión de estructuras jerárquicas: cabezas, líderes, personas e invitaciones.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "node scripts/build.js",
    "seed": "node scripts/seed.js",
    "seed:large": "node scripts/seed-large.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0"
  }
}
